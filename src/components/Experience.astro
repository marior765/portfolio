<section class="exp" id="experience">
  <div class="inner">
    <div class="section-header">
      <span class="section-num">01</span>
      <h2 class="section-title">Experience</h2>
    </div>
    <div class="jobs">
      {jobs.map((job) => (
        <div class="job">
          <div class="job-left">
            <span class="job-type">{job.type}</span>
            <span class="job-period">{job.period}</span>
            <span class="job-location">{job.location}</span>
          </div>
          <div class="job-right">
            <div class="job-header">
              <h3 class="job-role">{job.role}</h3>
              <span class="job-company">
                {job.companyUrl
                  ? <a href={job.companyUrl} target="_blank" rel="noopener noreferrer" class="co-link">{job.companyName}</a>
                  : job.companyName
                }
                {job.projectName && (
                  <> — {job.projectUrl
                    ? <a href={job.projectUrl} target="_blank" rel="noopener noreferrer" class="co-link">{job.projectName}</a>
                    : job.projectName
                  }</>
                )}
              </span>
            </div>
            <div class="job-body">
              <div class="job-stats">
                {job.stats.map(s => (
                  <div class="stat">
                    <span class="stat-value">{s.value}</span>
                    <span class="stat-label">{s.label}</span>
                  </div>
                ))}
              </div>
              <ul class="job-bullets">
                {job.bullets.map(b => <li>{b}</li>)}
              </ul>
              <div class="job-tags">
                {job.tags.map(t => <span class="tag">{t}</span>)}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>


<style>
.exp {
