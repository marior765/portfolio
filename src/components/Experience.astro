  font-size: 2.5rem;
  font-weight: 400;
  letter-spacing: -.02em;
}
.jobs {
  display: flex;
  flex-direction: column;
}
.job {
  display: grid;
  grid-template-columns: 200px 1fr;
  gap: 2rem;
  padding: 2.5rem 0;
  border-top: 1px solid var(--border);
}
.job:last-child {
  border-bottom: 1px solid var(--border);
}
.job-left {
  display: flex;
  flex-direction: column;
  gap: .4rem;
  padding-top: 2px;
}
.job-type {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--accent);
  letter-spacing: .08em;
  text-transform: uppercase;
}
.job-period {
  font-size: 12px;
  color: var(--text-2);
}
.job-location {
  font-size: 12px;
  color: var(--text-3);
}
.job-right {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.job-header {
  display: flex;
  flex-direction: column;
  gap: .2rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid var(--border);
}
.job-body {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.job-role {
  font-size: 15px;
  font-weight: 500;
  color: var(--text);
}
.job-company {
  font-size: 13px;
  color: var(--text-2);
}
.co-link {
  color: var(--text-2);
  text-decoration: underline;
  text-decoration-color: var(--border-strong);
  text-underline-offset: 3px;
  transition: color .2s, text-decoration-color .2s;
}
.co-link:hover {
  color: var(--accent);
  text-decoration-color: var(--accent);
}
.job-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.stat {
  display: flex;
  flex-direction: column;
  gap: 1px;
  padding: 8px 14px;
  background: var(--accent-dim);
  border: 1px solid var(--border-strong);
  border-radius: 6px;
}
.stat-value {
  font-family: var(--font-mono);
  font-size: 13px;
  font-weight: 500;
  color: var(--text-2);
  letter-spacing: .02em;
}
.stat-label {
  font-size: 11px;
  color: var(--text-2);
  letter-spacing: .02em;
}
.job-bullets {
  display: flex;
  flex-direction: column;
  gap: .55rem;
  padding-left: 1.1rem;
  font-size: 14px;
  color: var(--text-2);
  line-height: 1.8;
  font-weight: 300;
}
.job-bullets li::marker {
  color: var(--accent);
  font-size: 10px;
}
.job-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: .25rem;
}
.tag {
  font-size: 11px;
  font-family: var(--font-mono);
  padding: 3px 10px;
  border: 1px solid var(--border);
  border-radius: 3px;
  color: var(--text-3);
  letter-spacing: .03em;
}
@media (max-width: 700px) {
  .job { grid-template-columns: 1fr; gap: 1rem; }
  .job-left { flex-direction: row; flex-wrap: wrap; gap: .5rem 1rem; }
}
</style>
