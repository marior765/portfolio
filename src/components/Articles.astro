---
type Article = {
  title: string;
  subtitle: string;
  image: string | null;
  link: string;
  date: string;
};

function decode(s: string): string {
  return s
    .replace(/<[^>]+>/g, "")
    .replace(/&amp;/g, "&")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&quot;/g, '"')
    .replace(/&#39;|&#x27;/g, "'")
    .replace(/&nbsp;/g, " ")
    .trim();
}

async function getArticles(): Promise<Article[]> {
  try {
    const res = await fetch("https://medium.com/feed/@d.bohatyrchuk");
    if (!res.ok) return [];
    const xml = await res.text();

    const items = xml.split("<item>").slice(1);
    return items.map((item) => {
      const title = decode(
        item.match(/<title><!\[CDATA\[([\s\S]*?)\]\]><\/title>/)?.[1] ?? "",
      );
      const link = (item.match(/<link>([\s\S]*?)<\/link>/)?.[1] ?? "")
        .split("?")[0]
        .trim();
      const content =
        item.match(/<content:encoded><!\[CDATA\[([\s\S]*?)\]\]><\/content:encoded>/)?.[1] ?? "";
      const image = content.match(/<img[^>]+src="([^"]+)"/)?.[1] ?? null;

      // Pick the first reasonably long blockquote/paragraph as a subtitle.
      const blocks = [...content.matchAll(/<(?:blockquote|p)[^>]*>([\s\S]*?)<\/(?:blockquote|p)>/g)];
      let subtitle = "";
      for (const b of blocks) {
        const text = decode(b[1]);
        if (text.length > 40) {
          subtitle = text;
          break;
        }
      }
      if (subtitle.length > 180) subtitle = subtitle.slice(0, 177).trimEnd() + "…";

      const pub = item.match(/<pubDate>([\s\S]*?)<\/pubDate>/)?.[1] ?? "";
      const date = pub
        ? new Date(pub).toLocaleDateString("en-US", {
            month: "short",
            year: "numeric",
          })
        : "";

      return { title, subtitle, image, link, date };
    });
  } catch {
    return [];
  }
}

const articles = await getArticles();
---

{articles.length > 0 && (
  <section class="articles" id="writing">
    <div class="inner">
      <div class="section-header">
        <span class="section-num">00</span>
        <h2 class="section-title">Writing</h2>
        <a
          href="https://medium.com/@d.bohatyrchuk"
          target="_blank"
          rel="noopener"
          class="all-link"
        >
          All on Medium <span class="arrow">↗</span>
        </a>
      </div>
      <div class="article-grid">
        {articles.map((a) => (
          <a href={a.link} target="_blank" rel="noopener" class="article-card">
            {a.image && (
              <div class="article-thumb">
                <img src={a.image} alt={a.title} loading="lazy" />
              </div>
            )}
            <div class="article-body">
              <span class="article-date">{a.date}</span>
              <h3 class="article-title">{a.title}</h3>
              {a.subtitle && <p class="article-subtitle">{a.subtitle}</p>}
              <span class="article-read">Read on Medium <span class="arrow">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .articles {
    padding: 6rem 2rem;
    border-top: 1px solid var(--border);
  }
  .inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .section-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 3.5rem;
  }
  .section-num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    letter-spacing: 0.1em;
  }
  .section-title {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 400;
    letter-spacing: -0.02em;
  }
  .all-link {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-3);
    letter-spacing: 0.05em;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color 0.2s;
  }
  .all-link:hover {
    color: var(--accent);
  }
  .article-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }
  .article-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg-2);
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .article-card:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }
  .article-thumb {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-3);
  }
  .article-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  .article-card:hover .article-thumb img {
    transform: scale(1.04);
  }
  .article-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
  }
  .article-date {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-3);
    letter-spacing: 0.05em;
  }
  .article-title {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--text);
  }
  .article-subtitle {
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-2);
    font-weight: 300;
  }
  .article-read {
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .arrow {
    font-family: var(--font-sans);
  }
</style>
