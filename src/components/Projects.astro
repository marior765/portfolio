---
<section class="projects" id="projects">
  <div class="inner">
    <div class="section-header">
      <span class="section-num">02</span>
      <h2 class="section-title">Projects</h2>
    </div>
  </div>
  <div class="scroll-track">
    {projects.map(p => (
      <div class="card">
        <div class="card-top">
          <span class="card-num">{p.num}</span>
          <span class="card-highlight">{p.highlight}</span>
        </div>
        <h3 class="card-title">{p.title}</h3>
        <span class="card-cat">{p.category}</span>
        <p class="card-desc">{p.desc}</p>
        <div class="card-metrics">
          {p.metrics.map(m => <span class="metric">{m}</span>)}
        </div>
        {p.links && (
          <div class="card-links">
            {p.links.map(l => (
              <a href={l.url} target="_blank" rel="noopener noreferrer" class="card-link">{l.label} ↗</a>
            ))}
          </div>
        )}
      </div>
    ))}
  </div>
</section>

<style>
.projects {
  padding: 6rem 0;
  border-top: 1px solid var(--border);
  background: var(--bg-2);
  position: relative;
  overflow: hidden;
}
.projects::after {
  content: '';
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 120px;
  background: linear-gradient(to right, transparent, var(--bg-2));
  pointer-events: none;
  z-index: 1;
}
.inner {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 2rem;
}
.section-header {
  display: flex;
  align-items: baseline;
  gap: 1rem;
  margin-bottom: 3.5rem;
}
.section-num {
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--accent);
  letter-spacing: .1em;
}
.section-title {
  font-family: var(--font-serif);
  font-size: 2.5rem;
  font-weight: 400;
  letter-spacing: -.02em;
}
.scroll-track {
  display: flex;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  padding-left: max(2rem, calc((100vw - 1100px) / 2));
  padding-right: 8rem;
  padding-bottom: 1.5rem;
  border-top: 1px solid var(--border);
  scrollbar-width: thin;
  scrollbar-color: var(--border-strong) transparent;
}
.scroll-track::-webkit-scrollbar { height: 3px; }
.scroll-track::-webkit-scrollbar-track { background: transparent; }
.scroll-track::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: 2px; }
.card {
  flex-shrink: 0;
  width: 400px;
  border-right: 1px solid var(--border);
  padding: 2.25rem 2rem;
  display: flex;
  flex-direction: column;
  gap: .75rem;
  scroll-snap-align: start;
  transition: background .2s;
}
.card:first-child {
  border-left: 1px solid var(--border);
}
.card:hover {
  background: var(--bg-3);
}
.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: .25rem;
}
.card-num {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--text-3);
}
.card-highlight {
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--accent);
  background: var(--accent-dim);
  padding: 3px 10px;
  border-radius: 20px;
  letter-spacing: .05em;
}
.card-title {
  font-size: 16px;
  font-weight: 500;
  color: var(--text);
  line-height: 1.3;
}
.card-cat {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--text-3);
  letter-spacing: .04em;
}
.card-desc {
  font-size: 13px;
  color: var(--text-2);
  line-height: 1.8;
  font-weight: 300;
  margin-top: .25rem;
  flex: 1;
}
.card-metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: .5rem;
  padding-top: .75rem;
  border-top: 1px solid var(--border);
}
.metric {
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--text-3);
  padding: 3px 10px;
  border: 1px solid var(--border);
  border-radius: 3px;
  letter-spacing: .04em;
  background: var(--bg);
}
.card-links {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: .25rem;
}
.card-link {
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--accent);
  padding: 3px 10px;
  border: 1px solid var(--accent-dim);
  border-radius: 3px;
  background: var(--accent-dim);
  letter-spacing: .04em;
  transition: opacity .2s;
}
.card-link:hover {
  opacity: .75;
}
@media (max-width: 600px) {
  .card { width: 85vw; }
}
</style>
